  "status": "Contract catalog only; not an advertised surface or HTTP integration claim.",
  "rules": {
    "paths": "Relative to /api/v1. Domain modules own endpoint templates; this fixture is evidence, not runtime dispatch.",
    "responses": "Native objects stay extensible. Required receipt paths must be validated; optional paths are copied only if present and valid. Nested paths preserve their native hierarchy. Endpoint projectors validate their response shapes in their own packages.",
    "writes": "After dispatch, errors are unknown unless explicit native committed evidence or an exact endpoint-specific tested noncommitting rule establishes otherwise. Unclassified 4xx/5xx/redirect/parse/cancellation/size failures are unknown. Do not infer rejected from status alone.",
    "noncommitting": "Rules require exact status+code and a pinned native test proving unchanged resource/events. Explicit native committed evidence takes precedence and stays separate from meta.write.outcome.",
    "empty": "An expected 204 is its own validated success receipt; never invent returned IDs.",
    "optional": "Missing optional request fields are omitted. Nullable PATCH fields use Missing/Null/Value; non-null fields reject null. Native missing/null response fields are preserved.",
    "projection": "Success receipt extraction precedes optional projection enrichment and serialized MCP result budgeting. Validated write success overflow has data:null, isError:false, compact receipt and explicit omission."
  },
